{
  "name": "cro-chess-king",
  "version": "1.0.0",
  "description": "CRO CHESS KING - Offline Chess Game",
  "main": "main.js",
  "author": "CRO CHESS KING",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "publish": null,
    "appId": "com.crochessking.app",
    "productName": "CRO CHESS KING",
    "files": [
      "index_baru.html",
      "main.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
